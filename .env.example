# ============================================================
# Tender Paws A3 - environment variables
# Copy this file to .env and adjust for your machine.
# The server reads these directly from the environment.
# ============================================================

# Port the Express server listens on (defaults to 3102)
PORT=3102

# MySQL connection
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=charityevents_db
